# Terraform local directory (contains large binaries)
**/.terraform/
.terraform/

# Terraform state files (may contain sensitive data/IPs)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# CLI configuration and tfvars
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
